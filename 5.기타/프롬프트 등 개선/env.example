# API Keys (필수)
# 이 파일을 .env로 복사한 후 실제 키 입력
# .env는 절대 git commit 금지

# Anthropic API Key (02번·06a·06b 단권화·사례집 카드화용)
# 발급: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-여기에_실제_키_입력

# Google AI API Key (01번 OCR용)
# 발급: https://aistudio.google.com → Get API Key
GOOGLE_API_KEY=여기에_실제_키_입력

# Optional: 모델 버전 (default 사용 권장)
ANTHROPIC_MODEL=claude-opus-4-7
GOOGLE_MODEL=gemini-3.1-pro

# Optional: Obsidian vault 경로 (동기화 사용 시)
OBSIDIAN_VAULT_PATH=

# Optional: 비용 한도 (월 누적, USD)
# 초과 시 작업 중단하고 사용자 확인
MONTHLY_BUDGET_USD=50

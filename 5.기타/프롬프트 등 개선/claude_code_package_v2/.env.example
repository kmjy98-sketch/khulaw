# API Keys (필수)
# 이 파일을 .env로 복사한 후 실제 키 입력
# .env는 절대 git commit 금지

# Anthropic API Key (02-card·06a·06b 카드화 단계 — Claude Opus 4.8)
# v3.6 Phase 2 (2026-06): 2모델 역할분담 — 안티그래비티(Gemini 3.5 Flash)=01 OCR+02-wiki, Opus 4.8=카드화
# 01 OCR·02-wiki는 안티그래비티(Gemini 3.5 Flash) 측에서 처리하므로 GOOGLE/Gemini 키는 별도 환경에서 관리
# 발급: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-여기에_실제_키_입력

# Optional: 모델 버전 (default 사용 권장)
# 01 OCR·02-wiki: 안티그래비티(Gemini 3.5 Flash) — Anthropic 모델 아님 (이 변수 적용 안 됨)
# 02-card·06a·06b default: claude-opus-4-8 (카드화 핵심 엔진)
ANTHROPIC_MODEL=claude-opus-4-8

# Optional: Obsidian vault 경로 (동기화 사용 시)
OBSIDIAN_VAULT_PATH=

# Optional: 비용 한도 (월 누적, USD)
# 초과 시 작업 중단하고 사용자 확인
MONTHLY_BUDGET_USD=50
